    <!-- Onboarding -->
    <string name="onb_welcome_title">Bienvenido a WaliPet</string>
    <string name="onb_welcome_body">Tu mascota lee WhatsApp en voz alta y puede responder por ti.\nGana XP, sube de nivel y evoluciona con cada lectura.</string>
    <string name="onb_listener_title">Acceso a notificaciones</string>
    <string name="onb_listener_body">Para leer los mensajes de WhatsApp en segundo plano (todo se procesa localmente en tu dispositivo), concede a WaliPet el acceso a notificaciones.</string>
