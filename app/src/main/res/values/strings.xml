    <!-- Estado del sistema / Ajustes -->
    <string name="setup_title">Estado del sistema</string>
    <string name="setup_subtitle">Revisamos que todo esté listo para que WaliPet responda solo. Si falta algo, tócalo y se abre el ajuste correspondiente.</string>
    <string name="setup_listener_title">Acceso a notificaciones</string>
    <string name="setup_listener_body">Permite a WaliPet leer los mensajes de WhatsApp en segundo plano. Sin esto no responde nada.</string>
    <string name="setup_notifications_title">Notificaciones de la app</string>
    <string name="setup_notifications_body">Para avisarte cuando tu WaliPet lea un chat y suba de nivel.</string>
    <string name="setup_battery_title">Ahorro de batería</string>
    <string name="setup_battery_body">Eximir a WaliPet del ahorro agresivo hace que responda más rápido, incluso con la pantalla apagada.</string>
