<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notificaciones de la app (avisos de "WaliPet respondió" en Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reactivar el watchdog tras un reinicio del dispositivo. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Onboarding: pedir exención de la optimización agresiva de batería (acción del usuario). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".WaliPetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaliPet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WaliPet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            El corazón de WaliPet: escucha las notificaciones de WhatsApp en
            segundo plano. El usuario debe conceder "Acceso a notificaciones"
            desde Ajustes (la app lo guía en el onboarding).
        -->
        <service
            android:name=".service.WaliPetNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Recordatorio tras el arranque si el acceso a notificaciones está desactivado. -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
